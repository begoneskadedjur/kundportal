{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    // Inkludera alla API-filer med rätt filändelse
    "api/**/*.ts",

    // Inkludera de lib-filer som servern använder
    "src/lib/clickup.ts",
    "src/lib/supabase-admin.ts",
    "src/lib/pdf-generator.ts",
    "src/lib/begoneLogo.ts",
    "src/types/database.ts",
    "src/types/leads.ts",
    // Specialrapporter (api/special-report-pdf)
    "src/types/specialReport.ts",
    // Snygga till (api/polish-text)
    "src/types/textPolish.ts",

    // Delad schemagenerator (extend-recurring-schedules-cronen) — samma
    // algoritm som klientens wizard, med timeZone-parameter för servern
    "src/types/recurringSchedule.ts",
    "src/utils/inspectionDateGenerator.ts",
    "src/utils/swedishHolidays.ts",

    // Fritext-stationstyp → station_types.code (generate-station-map-pdf)
    "src/utils/stationTaxonomy.ts",

    // Delad periodmatematik för årspremiefakturor (generate-continuing-contracts)
    "src/shared/contractPlanner.ts",

    // Schemahorisonten (extend-recurring-schedules), samma regel som fakturorna
    "src/shared/scheduleHorizon.ts",

    // Delade kundnummerregler för Fortnox-spegeln och allokeringen
    "src/shared/fortnoxCustomerNumbers.ts",
    // Fakturavägen (signeringen, Oneflow-webhooken, allocate-customer)
    "src/shared/invoiceDelivery.ts",

    // Signeringsbehandlingen av avtal (api/_lib/contractSigning.ts): ärende-
    // statusar, premie/org.nr-regler, fakturarader och andelar av premien
    "src/shared/documentStatus.ts",
    "src/shared/contractSigning.ts",
    "src/shared/contractInvoiceRows.ts",
    "src/shared/premiumShares.ts",
    "src/shared/webLeadUppgifter.ts",

    // Upphandlingsportalen: radtyper och rena regler (matchning, dedup,
    // avtalsslut, län) som delas mellan synk-cronen och klienten
    "src/types/procurement.ts",
    "src/shared/procurementRules.ts",
    "src/shared/procurementAppendix.ts",
    // RFI-läget: docx-utläsning med ankare och svarslogik (api/procurement/rfi)
    "src/shared/procurementRfi.ts",
    "src/shared/procurementRfiDocx.ts",

    // Stationsmarkörer (typens färg och ikon, tillägg, status) i kundrapporterna
    "src/shared/stationMarkers.ts",
    "src/shared/reportStationMarkers.ts", "src/shared/stationNumbering.ts"

    // OBS: vite.config.ts kan inte typkollas här — Vite är ESM-only och detta
    // projekt använder NodeNext utan "type": "module" i package.json.
    // Vite validerar själv configen vid build.
  ]
}