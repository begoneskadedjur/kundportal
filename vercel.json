{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-contracts",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/contract-renewal-watch",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/sync-embeddings",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-ai-images",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sync-oneflow",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/extend-recurring-schedules",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-continuing-contracts",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/reactivate-paused-billing",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/monthly-customer-snapshot",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/send-booking-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-fortnox-customers",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/sync-fortnox-customers-incremental",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/procurement-sync-mercell",
      "schedule": "0 4-20 * * 1-5"
    },
    {
      "path": "/api/cron/procurement-sync-ted",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/procurement-sync-kommers",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/procurement-deadlines",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/procurement-digest",
      "schedule": "45 5,6 * * 1-5"
    },
    {
      "path": "/api/cron/procurement-signals",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sync-google-reviews",
      "schedule": "45 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
